{
  "authority": {
    "base_contract_version": "2.0.0",
    "footer_extension_source": "AtlasReaper311/atlas-infra:policy/public-interface-footer-extension-v1.json",
    "footer_extension_version": "1.0.0",
    "foundation_extension_source": "AtlasReaper311/atlas-infra:policy/public-interface-foundation-extension-v1.json",
    "foundation_extension_version": "1.0.0"
  },
  "breadcrumb_navigation": {
    "accessible_name_required": true,
    "applies_to": "hierarchical-human-facing-routes",
    "current_page": [
      "text",
      "aria-current=page"
    ],
    "homepage_forbidden": true,
    "landmark": "nav",
    "machine_surfaces_excluded": true,
    "ordered_list_required": true,
    "purpose_specific_opt_out_allowed": true,
    "required": false,
    "role": "breadcrumb-navigation",
    "selector": ".atlas-breadcrumbs"
  },
  "dense_data_overflow": {
    "applies_to": [
      "table",
      "code",
      "preformatted-output",
      "dense-data-region"
    ],
    "content_and_rendering_owner": "consumer",
    "extends_role": "table-wrapper",
    "overflow_detection_owner": "consumer",
    "overflow_state_attribute": "data-overflow=true",
    "selector": ".atlas-table-wrap",
    "when_not_overflowing": {
      "unnecessary_tab_stop_forbidden": true
    },
    "when_overflowing": {
      "accessible_name_required": true,
      "keyboard_focus_required": true,
      "local_horizontal_scroll_required": true,
      "tabindex": "0",
      "visible_focus_required": true
    }
  },
  "distribution": {
    "consumer_adoption_requires_separate_pull_request": true,
    "consumer_rollout_requires_separate_approval": true,
    "remote_runtime_dependency_forbidden": true,
    "repository_local_assets_required": true,
    "shared_runtime_javascript_forbidden": true
  },
  "evidence": {
    "blocking_viewports_px": [
      320,
      375,
      768,
      1024,
      1440
    ],
    "reporting_only_changes_content_width": false,
    "reporting_only_changes_layout_tokens": false,
    "reporting_only_is_breakpoint": false,
    "reporting_only_is_budget": false,
    "reporting_only_viewports_px": [
      1920
    ]
  },
  "footer_authority": {
    "accessible_name_required_when_multiple": true,
    "behaviour": {
      "atlas_owned_html_same_tab_required": true,
      "external_links_new_tab_required": true,
      "external_links_rel": "noopener noreferrer",
      "fixed_bottom_navigation_clearance_required": true,
      "global_navigation_duplication_forbidden": true,
      "minimum_touch_target_px": 44,
      "mobile_wrap_required": true,
      "purpose_specific_labels_required": true,
      "reduced_motion_required": true,
      "visible_focus_required": true
    },
    "empty_footer_forbidden": true,
    "empty_slots_forbidden": true,
    "ownership": {
      "article_sequence_owner": "AtlasReaper311/atlas-scheduler",
      "consumer_content_owner": true,
      "implementation_owner": "AtlasReaper311/atlas-interface-kit",
      "shared_runtime_javascript_forbidden": true
    },
    "role": "footer",
    "selector": ".atlas-footer",
    "semantic_element": "footer",
    "single_primary_footer_required": true,
    "slots": {
      "context": {
        "content_owner": "consumer",
        "required_globally": false,
        "selector": ".atlas-footer__context"
      },
      "estate_escape": {
        "content_owner": "consumer",
        "required_globally": true,
        "selector": ".atlas-footer__escape"
      },
      "evidence": {
        "content_owner": "consumer",
        "required_globally": false,
        "selector": ".atlas-footer__evidence"
      },
      "identity": {
        "content_owner": "consumer",
        "required_globally": true,
        "selector": ".atlas-footer__identity"
      },
      "sequence": {
        "article_owner": "AtlasReaper311/atlas-scheduler",
        "content_owner": "consumer-or-publisher",
        "required_globally": false,
        "selector": ".atlas-footer__sequence"
      }
    },
    "variants": {
      "editorial": {
        "forbidden_slots": [],
        "optional_slots": [
          "context",
          "evidence"
        ],
        "required_slots": [
          "identity",
          "sequence",
          "estate_escape"
        ],
        "selector": ".atlas-footer--editorial"
      },
      "estate": {
        "forbidden_slots": [
          "sequence"
        ],
        "optional_slots": [
          "context",
          "evidence"
        ],
        "required_slots": [
          "identity",
          "estate_escape"
        ],
        "selector": ".atlas-footer--estate"
      },
      "product": {
        "forbidden_slots": [
          "sequence"
        ],
        "optional_slots": [
          "context",
          "evidence"
        ],
        "required_slots": [
          "identity",
          "estate_escape"
        ],
        "selector": ".atlas-footer--product"
      },
      "tool": {
        "forbidden_slots": [
          "sequence"
        ],
        "optional_slots": [
          "evidence"
        ],
        "required_slots": [
          "identity",
          "context",
          "estate_escape"
        ],
        "selector": ".atlas-footer--tool"
      }
    }
  },
  "schema_version": "atlas-interface-kit/semantics/v1",
  "status_announcement": {
    "announce_on": [
      "meaningful-user-visible-state-transition"
    ],
    "blocking_failure_semantics": {
      "role": "alert",
      "use": "immediate-blocking-failure-only"
    },
    "default_semantics": {
      "aria_atomic": "true",
      "aria_live": "polite",
      "role": "status"
    },
    "global_header_status_remains_aria_live_off": true,
    "required": false,
    "role": "status-announcement",
    "selector": ".atlas-status-announcement",
    "shared_runtime_javascript_forbidden": true,
    "silent_on": [
      "initial-poll",
      "unchanged-poll",
      "routine-refresh"
    ],
    "trigger_owner": "consumer",
    "wording_owner": "consumer"
  },
  "version": "0.4.0"
}
