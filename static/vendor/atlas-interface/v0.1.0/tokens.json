{
  "$schema": "./tokens.schema.json",
  "schema_version": "atlas-interface-kit/tokens/v1",
  "version": "0.1.0",
  "color": {
    "background": {
      "page": "#0a0a0f",
      "surface": "#111118",
      "nested": "#1a1a24"
    },
    "border": {
      "default": "rgba(255,255,255,0.08)",
      "strong": "rgba(255,255,255,0.16)"
    },
    "text": {
      "primary": "#e8e8e0",
      "secondary": "#aaa9a0",
      "faint": "#555560"
    },
    "brand": {
      "accent": "#f5a623",
      "accent_active": "#d97706",
      "accent_soft": "rgba(245,166,35,0.12)"
    },
    "state": {
      "operational": "#4ade80",
      "degraded": "#f5a623",
      "unavailable": "#e24b4a",
      "unknown": "#888894",
      "informational": "#60a5fa"
    }
  },
  "font": {
    "serif": "\"DM Serif Display\", Georgia, serif",
    "mono": "\"IBM Plex Mono\", monospace"
  },
  "type": {
    "body": {"size": "16px", "line_height": 1.7},
    "supporting": {"size": "14px", "line_height": 1.65},
    "metadata": {"size": "11px", "line_height": 1.5},
    "label": {"size": "10px", "line_height": 1.4, "letter_spacing": "0.08em"},
    "display": {"min": "2.25rem", "preferred": "5vw", "max": "4.75rem"},
    "page_title": {"min": "2rem", "preferred": "4vw", "max": "3.75rem"},
    "section_title": {"min": "1.5rem", "preferred": "2.5vw", "max": "2.25rem"}
  },
  "space": [4,8,12,16,24,32,48,64,96],
  "size": {
    "control": {"compact": 32, "standard": 40, "touch_target": 44},
    "radius": {"small": 4, "medium": 6, "large": 8},
    "content": {"prose": 720, "standard": 1100, "wide": 1280},
    "header": 56
  },
  "breakpoint": {"compact": 420, "mobile": 680, "tablet": 880, "desktop": 1100, "wide": 1440},
  "motion": {"fast": "120ms", "standard": "180ms", "reveal": "240ms", "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"},
  "layer": {"base": 0, "sticky": 100, "overlay": 300, "dialog": 400, "toast": 500},
  "immutable": ["focus-visibility","semantic-state-colours","minimum-text-contrast","minimum-touch-target","spacing-scale-values","base-breakpoints","global-header-contract","z-index-layer-meanings","reduced-motion-behaviour"],
  "brand_expression_overrides": ["product-accent","product-glow","product-panel-background","product-motion-intensity","diagram-palette"]
}
