{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas-systems.uk/contracts/interface-kit/tokens-v1.schema.json",
  "title": "Atlas Systems interface token source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "color", "font", "type", "space", "size", "breakpoint", "motion", "layer", "immutable", "brand_expression_overrides"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "atlas-interface-kit/tokens/v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "color": {"type": "object"},
    "font": {"type": "object"},
    "type": {"type": "object"},
    "space": {"const": [4, 8, 12, 16, 24, 32, 48, 64, 96]},
    "size": {"type": "object"},
    "breakpoint": {"type": "object"},
    "motion": {"type": "object"},
    "layer": {"type": "object"},
    "immutable": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "brand_expression_overrides": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
