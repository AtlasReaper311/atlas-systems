/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://api.atlas-systems.uk https://ramone.atlas-systems.uk https://corpus.atlas-systems.uk https://static.cloudflareinsights.com; img-src 'self' data: https://res.cloudinary.com;
  Cache-Control: no-cache, max-age=0, must-revalidate

/lab/console/*
  X-Robots-Tag: noindex, follow

/static/vendor/atlas-interface/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/lab/system-symphony
  Cache-Control: no-cache, max-age=0, must-revalidate
  X-Atlas-System-Symphony-Build: 20260720-system-symphony-loop-production-v2

/lab/system-symphony/
  Cache-Control: no-cache, max-age=0, must-revalidate
  X-Atlas-System-Symphony-Build: 20260720-system-symphony-loop-production-v2

/lab/system-symphony/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate
  X-Atlas-System-Symphony-Build: 20260720-system-symphony-loop-production-v2

/static/js/sonify/*
  Cache-Control: no-cache, max-age=0, must-revalidate
  X-Atlas-System-Symphony-Build: 20260720-system-symphony-loop-production-v2
