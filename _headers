/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com https://static.cloudflareinsights.com; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.atlas-systems.uk https://ramone.atlas-systems.uk https://corpus.atlas-systems.uk https://atlas-vault.anonymous30141592654.workers.dev https://challenges.cloudflare.com https://static.cloudflareinsights.com; img-src 'self' data: https://res.cloudinary.com;
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/lab/*.css
  Cache-Control: public, max-age=60, must-revalidate

/lab/*.js
  Cache-Control: public, max-age=60, must-revalidate

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=3600, must-revalidate
